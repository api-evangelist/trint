  "item": [
    {
      "id": "3e478d72-353d-4761-8480-2c57ffcb075b",
      "name": "Upload and Transcribe",
      "description": {
        "content": "Upload or ingest media and start automatic transcription.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "6507d60d-64b3-45df-837a-b641591254a4",
          "name": "Upload and transcribe a media file",
          "request": {
            "name": "Upload and transcribe a media file",
            "description": {
              "content": "Uploads a media file directly to Trint as a binary payload and begins transcription immediately. Once the upload completes the file appears on the My Trints page and automatically starts transcribing. Supported formats include MP4, MOV, AVI, WAV, MP3, and others. Note the host is https://upload.trint.com, not the main api.trint.com host.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "upload"
              ],
              "host": [
                "{{upload-Url}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "filename",
                  "value": "<string>",
                  "description": "(Required) The file name to store the upload under."
                },
                {
                  "disabled": false,
                  "key": "language",
                  "value": "<string>",
                  "description": "Language code for transcription (for example en, es, fr)."
                },
                {
                  "disabled": false,
                  "key": "user",
                  "value": "<string>",
                  "description": "Username to attach the file to."
                },
                {
                  "disabled": false,
                  "key": "metadata",
                  "value": "<string>",
                  "description": "Arbitrary metadata echoed back on the webhook callback event."
                },
                {
                  "disabled": false,
                  "key": "detect-speaker-change",
                  "value": "true",
                  "description": "Enable speaker separation / diarization. Defaults to true."
                },
                {
                  "disabled": false,
                  "key": "folder-id",
                  "value": "<string>",
                  "description": "Destination folder ID."
                },
                {
                  "disabled": false,
                  "key": "workspace-id",
                  "value": "<string>",
                  "description": "Destination workspace / shared drive ID."
                },
                {
                  "disabled": false,
                  "key": "custom-dictionary",
                  "value": "true",
                  "description": "Apply Vocab Builder custom dictionary. Defaults to true."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/octet-stream"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "file"
            }
          },
          "response": [
